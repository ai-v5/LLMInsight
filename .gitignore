# --- Secrets & sensitive data (NEVER commit) ---
secret/
*.key
api_key*.txt

# --- Profiling raw data (large / sensitive) ---
*ASCEND_PROFILER_OUTPUT*/
*.pb
*.db
local_profilings/

# --- Runtime artifacts (restart_insight.sh) ---
insight.log
.insight.pid

# --- Caches / build artifacts ---
.llminsight_cache/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Wheel build (scripts/build_wheel.py) ---
/dist/
/build/
# staged copies of the root web/ & configs/ dirs (build_wheel.py stages then removes these)
/llminsight/web/
/llminsight/configs/

# --- Scratch / smoke scripts (underscore-prefixed, any language) ---
scripts/_*

# --- Editor / OS ---
.claude/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Node (frontend uses CDN, but ignore just in case) ---
node_modules/
